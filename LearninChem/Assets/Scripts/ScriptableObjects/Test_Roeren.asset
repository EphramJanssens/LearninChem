  m_Script: {fileID: 11500000, guid: 5a4baab0f7c307b44b4dfb87cb7e74e1, type: 3}
  m_Name: Test_Roeren
  m_EditorClassIdentifier: Assembly-CSharp::ModuleData
  moduleName: 
  stepActionIDs:
  - PlaceBeakerOnScale
  - TareScale
  - AddKalk
  - AddWater
  - StirSolution
  stepDescriptions:
  - Plaats de beker
  - Kalibreer de weegschaal
  - Voeg de kalk toe
  - Voeg oplosmiddel toe
  - Meng de oplossing
  stepInfo:
  - Pak een lege glazen beker en zet deze op de weegschaal.
  - Druk op de 'Tarra' (of nul) knop op de weegschaal om het gewicht van het glas
    te negeren.
  - Pak het potje kalk en houd deze boven de beker om 5.50g toe te voegen.
  - Pak de beker van de weegschaal. Gebruik de spuitfles met gedestilleerd water
    om de beker te vullen.
  - Pak de glazen roerstaaf en roer rustig in de beker totdat de kalk is opgelost.
