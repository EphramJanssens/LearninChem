:root {
}



#StartTrainingBtn {
    /* Base Styles moved from UXML */
    background-color: rgb(52, 152, 219);
    background-image: none;
    background-position-x: left 0;
    background-size: 43% 100%;
    
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    
    border-left-color: rgb(52, 152, 219);
    border-right-color: rgb(52, 152, 219);
    border-top-color: rgb(52, 152, 219);
    border-bottom-color: rgb(52, 152, 219);
    
    width: 350px;
    height: 50px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Examples%20&%20Extras/Fonts/Roboto-Bold.ttf?fileID=12800000&amp;guid=4beb055f07aaff244873dec698d0363e&amp;type=3#Roboto-Bold");
    font-size: 32px;
    color: rgb(37, 41, 48);

    /* Transitions */
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
    transition-property: background-color, color, scale, border-color;
}

#StartTrainingBtn:hover {
    background-color: rgb(26, 29, 36);
    color: rgb(255, 255, 255);
    
    /* Optional: Change the border color too so it doesn't stay blue */
    border-color: rgb(26, 29, 36); 
}
