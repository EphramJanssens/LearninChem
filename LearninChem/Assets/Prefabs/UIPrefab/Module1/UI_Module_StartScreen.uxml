<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Prefabs/UIPrefab/Module1/ButtonStyle.uss?fileID=7433441132597879392&amp;guid=62c164e983c8b1e4c8952b1c976a87db&amp;type=3#ButtonStyle"/>
    <ui:VisualElement name="Backgound" style="flex-grow: 1; -unity-background-image-tint-color: rgb(37, 41, 48); background-color: rgb(37, 41, 48);">
        <ui:Label text="Module 1: PBM&apos;s" name="Header" style="background-color: rgb(26, 29, 36); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Roboto-Bold.ttf?fileID=12800000&amp;guid=4beb055f07aaff244873dec698d0363e&amp;type=3#Roboto-Bold&quot;); font-size: 32px; color: rgb(255, 255, 255); padding-left: 60px; -unity-text-align: middle-left; position: relative; align-self: stretch; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; height: 60px;"/>
        <ui:VisualElement name="InfoContainer" style="flex-grow: 1; align-items: center; justify-content: space-evenly; align-self: auto; align-content: flex-start; flex-direction: column; flex-wrap: nowrap; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
            <ui:VisualElement name="PPEInfoPanel1" style="flex-grow: 1; flex-direction: row; justify-content: space-around; align-items: center; align-self: center; width: 350px; align-content: auto; max-width: 700px; max-height: 60px; min-width: 350px; min-height: 60px; background-color: rgb(26, 29, 36); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;">
                <ui:Image name="GogglesImg" style="background-image: url(&quot;project://database/Assets/Images/Safety_goggles_transparent_white.png?fileID=21300000&amp;guid=f922b9ee41d4d924c9e6b43f4e7e15d5&amp;type=3#Safety_goggles_transparent_white&quot;); align-self: auto; align-items: stretch; flex-direction: row; background-position-x: left 0; background-position-y: center; -unity-background-scale-mode: stretch-to-fill; width: 125px; height: 50px; background-size: 50% 50%; margin-right: -30px; margin-left: -30px; padding-left: 0; padding-right: 0;"/>
                <ui:Label text="Visie bescherming" name="VisieBescherming" style="color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts &amp; Materials/Roboto-Medium&quot;); font-size: 24px; flex-direction: row;"/>
            </ui:VisualElement>
            <ui:VisualElement name="PPEInfoPanel2" style="flex-grow: 1; flex-direction: row; justify-content: space-around; align-items: center; align-self: center; width: 350px; align-content: auto; max-width: 700px; max-height: 60px; min-width: 350px; min-height: 60px; background-color: rgb(26, 29, 36); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;">
                <ui:Image name="GlovesImg" style="background-image: url(&quot;project://database/Assets/Images/Safety_gloves_transparent_white.png?fileID=21300000&amp;guid=68a0b22fee6575b48a5e6cac4ef25993&amp;type=3#Safety_gloves_transparent_white&quot;); align-self: auto; align-items: stretch; flex-direction: row; background-position-x: left 0; background-position-y: center; -unity-background-scale-mode: stretch-to-fill; width: 125px; height: 50px; background-size: 50% 100%; margin-right: -30px; margin-left: -30px; padding-left: 0; padding-right: 0;"/>
                <ui:Label text="Hand bescherming" name="HandBescherming" style="color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts &amp; Materials/Roboto-Medium&quot;); font-size: 24px; flex-direction: row;"/>
            </ui:VisualElement>
            <ui:VisualElement name="PPEInfoPanel3" style="flex-grow: 1; flex-direction: row; justify-content: space-around; align-items: center; align-self: center; width: 350px; align-content: auto; max-width: 700px; max-height: 60px; min-width: 350px; min-height: 60px; background-color: rgb(26, 29, 36); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;">
                <ui:Image name="LabCoatImg" style="background-image: url(&quot;project://database/Assets/Images/Safety_coat_transparent_white.png?fileID=21300000&amp;guid=7dedf11d52daad74ea0545e4faf228a6&amp;type=3#Safety_coat_transparent_white&quot;); align-self: auto; align-items: stretch; flex-direction: row; background-position-x: left 0; background-position-y: center; -unity-background-scale-mode: stretch-to-fill; width: 125px; height: 50px; background-size: 50% 100%; margin-right: -30px; margin-left: -15px; padding-left: 0; padding-right: 0;"/>
                <ui:Label text="Lichaam bescherming" name="LichaamBescherming" style="color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts &amp; Materials/Roboto-Medium&quot;); font-size: 24px; flex-direction: row; justify-content: space-around;"/>
            </ui:VisualElement>
            <ui:Button text="Start training" name="StartTrainingBtn"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
